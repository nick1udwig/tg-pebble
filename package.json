{
  "name": "tg-pebble",
  "version": "0.2.0",
  "private": true,
  "description": "Read your Telegram messages and send Telegram messages using dictation.",
  "keywords": [
    "pebble-app"
  ],
  "author": "tg",
  "pebble": {
    "displayName": "tg",
    "uuid": "2f9865aa-e12b-47f2-b6fb-47f27a8ee101",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "diorite",
      "emery",
      "flint"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable"
    ],
    "messageKeys": {
      "MessageType": 0,
      "PayloadJson": 1,
      "RequestId": 2,
      "SyncState": 3
    },
    "resources": {
      "media": [
        {
          "name": "APP_ICON",
          "type": "bitmap",
          "file": "tg-pebble-menu-icon.png",
          "menuIcon": true
        }
      ]
    }
  },
  "scripts": {
    "test": "npm run test:js && npm run test:c && npm run test:config",
    "test:js": "bash scripts/test-js.sh",
    "test:c": "bash scripts/test-c.sh",
    "test:config": "bash scripts/test-config.sh",
    "test:telegram": "bash scripts/test-telegram.sh",
    "build:tl-schema": "node scripts/compile-tl-schema.mjs",
    "check:tl-schema": "node scripts/compile-tl-schema.mjs --check && node scripts/check-telegram-schema-layer.mjs",
    "check:tl-schema:remote": "node scripts/compile-tl-schema.mjs --check && node scripts/check-telegram-schema-layer.mjs --remote",
    "build:pkjs-legacy": "node scripts/build-pkjs-legacy.mjs",
    "build:watch": "npm run build:pkjs-legacy && pebble build",
    "test:emulator": "bash scripts/test-emulator.sh",
    "test:emulator:matrix": "bash scripts/test-emulator-matrix.sh",
    "test:emulator:soak": "bash scripts/test-emulator-soak.sh",
    "reset:emulator:app-storage": "bash scripts/reset-emulator-app-storage.sh",
    "run:emulator": "bash scripts/run-emulator.sh",
    "run:emulator:live": "TG_PEBBLE_FIXTURE_MODE=0 bash scripts/run-emulator.sh",
    "run:emulator:window": "TG_PEBBLE_EMULATOR_VNC=0 bash scripts/run-emulator.sh",
    "run:emulator:live:window": "TG_PEBBLE_EMULATOR_VNC=0 TG_PEBBLE_FIXTURE_MODE=0 bash scripts/run-emulator.sh",
    "cleanup:sessions": "bash scripts/cleanup-dev-sessions.sh",
    "test:pre-release": "bash scripts/test-pre-release.sh",
    "dev:config": "node scripts/serve-config-page.mjs --port 4173",
    "capture:baselines": "bash scripts/capture-baselines.sh",
    "review:visual": "bash scripts/review-visual-diffs.sh",
    "test:emulator:states": "bash scripts/test-emulator-states.sh",
    "test:emulator:relaunch": "bash scripts/test-emulator-relaunch.sh",
    "test:emulator:visual": "bash scripts/test-emulator-visual.sh",
    "build:config:docs": "node scripts/build-config-docs.mjs",
    "build:watch:release": "npm run build:watch && node scripts/build-release-pbw.mjs",
    "deploy:phone": "bash scripts/build-and-install-phone.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "esbuild": "^0.25.11",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "pako": "^2.1.0"
  }
}
