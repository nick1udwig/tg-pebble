{
  "name": "tg-pebble",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram client for Pebble with PKJS, local cache, and watch-side UI.",
  "keywords": [
    "pebble-app"
  ],
  "author": "TG Pebble",
  "pebble": {
    "displayName": "TG Pebble",
    "uuid": "2f9865aa-e12b-47f2-b6fb-47f27a8ee101",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "diorite",
      "emery",
      "flint"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable"
    ],
    "messageKeys": {
      "MessageType": 0,
      "PayloadJson": 1,
      "RequestId": 2,
      "SyncState": 3
    },
    "resources": {
      "media": []
    }
  },
  "scripts": {
    "test": "npm run test:js && npm run test:c && npm run test:config",
    "test:js": "bash scripts/test-js.sh",
    "test:c": "bash scripts/test-c.sh",
    "test:config": "bash scripts/test-config.sh",
    "test:telegram": "bash scripts/test-telegram.sh",
    "test:emulator": "bash scripts/test-emulator.sh",
    "dev:config": "node scripts/serve-config-page.mjs --port 4173",
    "capture:baselines": "bash scripts/capture-baselines.sh",
    "review:visual": "bash scripts/review-visual-diffs.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "telegram": "^2.26.22"
  }
}
